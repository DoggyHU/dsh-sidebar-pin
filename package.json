{
  "name": "dsh-sidebar-pin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 侧边栏置顶区：把常用的工作区与会话钉在「工作区」上方，会话行同步官方状态（运行中转圈 / 完成绿点 / 等待处理黄点）。",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": []
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "license": "MIT"
}
